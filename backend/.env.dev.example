# PharmaTimer F3-S1-bis - Template env vars dev
# Copia in backend/.env.dev (gitignored) e personalizza se necessario
# Strategy (c) Docker MySQL container Studio-side, port host 3306

# Database (mysql-connector-python diretto, no ORM)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pharmatimer
DB_PASSWORD=pharmatimer_dev_2026
DB_NAME=pharmatimer_dev
DB_NAME_TEST=pharmatimer_test

# Connection pool size (sub-AMB F3-S1.C default 5)
DB_POOL_SIZE=5

# Server FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# CORS dev permissive (sub-AMB F3-S1.D, prod restrictive in F3-S6)
CORS_ORIGINS=http://localhost:5173
