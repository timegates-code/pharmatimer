<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pharmatimer.pianificatore</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/marketreader/PharmaTimer/.venv/bin/python</string>
    <string>-m</string>
    <string>pharmatimer_api.pianificatore</string>
  </array>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/marketreader/PharmaTimer/logs/pianificatore.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/marketreader/PharmaTimer/logs/pianificatore.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/marketreader/PharmaTimer/backend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DB_DEFAULTS_FILE</key>
    <string>/Users/marketreader/.my-pharmatimer.cnf</string>
    <key>DB_NAME</key>
    <string>pharmatimer</string>
    <key>VAPID_PEM_FILE</key>
    <string>/Users/marketreader/.pharmatimer-vapid.pem</string>
  </dict>
</dict>
</plist>
